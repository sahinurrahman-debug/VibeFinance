# VibeFinance - PRODUCTION configuration template (set these in your host's dashboard, e.g. Render
# "Environment" tab; do NOT commit a filled-in copy of this file).

VF_ENV=production

# REQUIRED. 32+ random characters. Used to hash session tokens. Rotating it signs everyone out.
#   python -c "import secrets; print(secrets.token_hex(32))"
VF_SECRET_KEY=<generate-me>

# Session cookie is Secure + HttpOnly + SameSite=Lax. Do not disable in production.
VF_COOKIE_SECURE=true
# Trust X-Forwarded-For from the platform proxy (needed for per-IP rate limits behind Render/Heroku).
VF_TRUST_PROXY=true
# Your public origin(s), comma separated, e.g. https://vibefinance.onrender.com  (same-origin is always allowed)
VF_ALLOWED_ORIGINS=https://YOUR-APP.onrender.com
# Swagger UI is off in production unless you opt in
VF_ENABLE_DOCS=false

VF_SESSION_DAYS=7
VF_GUEST_HOURS=24
VF_MAX_GUESTS=500

# Render's disk is ephemeral: the SQLite DB and vector index are rebuilt on every restart.
# Mount a persistent disk and point these at it to keep member accounts across deploys.
VF_DB=/var/data/vibefinance.db
VF_QDRANT=/var/data/qdrant
VF_DATA_DIR=/var/data

VF_LOG_LEVEL=INFO
