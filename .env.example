# VibeFinance - DEVELOPMENT configuration template.
#   cp .env.example .env        (then edit; .env is git-ignored and must never be committed)
# Real environment variables always override values in .env.
# For deployment values see .env.production.example.

# --- Profile ---------------------------------------------------------------
# development | test | production
VF_ENV=development

# --- Security --------------------------------------------------------------
# Optional in development: if empty, a random key is generated into data/dev_secret.key (git-ignored).
# REQUIRED in production (>= 32 random chars):  python -c "import secrets; print(secrets.token_hex(32))"
VF_SECRET_KEY=
# Secure flag on the session cookie. Leave false for http://localhost; it is forced on in production.
VF_COOKIE_SECURE=false
# Extra browser origins allowed to call the API (comma separated). Same-origin is always allowed.
VF_ALLOWED_ORIGINS=
# Serve Swagger UI at /docs (on in development, off in production by default)
VF_ENABLE_DOCS=true
VF_SESSION_DAYS=7
VF_GUEST_HOURS=24

# --- Storage ---------------------------------------------------------------
VF_DB=data/vibefinance.db
VF_QDRANT=data/qdrant
# auto | qdrant | qdrant-memory | numpy
VF_VECTOR=auto

# --- Engine / simulation ---------------------------------------------------
VF_SEED=42
# 1.0 = simulated feed latency on (shows the parallel speed-up); 0 = off (tests)
VF_IO_SCALE=1.0
VF_AGENT_TIMEOUT=1.2
VF_WORKERS=48
VF_LOG_LEVEL=DEBUG
